{
  "name": "poolpay-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "Production Turborepo monorepo featuring Next.js 16 Dashboard frontend (admin), Express.js + Mongoose + BullMQ backend, and Flutter mobile app.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "dev:backend": "turbo dev --filter=@repo/backend",
    "dev:mobile": "turbo dev --filter=@repo/mobile",
    "dev:klx": "turbo dev --filter=@repo/klx-luxe-plus",
    "dev:web": "turbo dev --filter=@repo/admin",
    "dev:api": "turbo dev --filter=@repo/backend",
    "admin": "turbo dev --filter=@repo/admin",
    "backend": "turbo dev --filter=@repo/backend",
    "mobile": "turbo dev --filter=@repo/mobile",
    "build": "turbo build",
    "build:admin": "turbo build --filter=@repo/admin",
    "build:backend": "turbo build --filter=@repo/backend",
    "build:mobile": "turbo build --filter=@repo/mobile",
    "build:klx": "turbo build --filter=@repo/klx-luxe-plus",
    "build:web": "turbo build --filter=@repo/admin",
    "build:api": "turbo build --filter=@repo/backend",
    "start": "turbo start",
    "start:admin": "turbo start --filter=@repo/admin",
    "start:backend": "turbo start --filter=@repo/backend",
    "start:web": "turbo start --filter=@repo/admin",
    "start:api": "turbo start --filter=@repo/backend",
    "lint": "turbo lint",
    "lint:admin": "turbo lint --filter=@repo/admin",
    "lint:backend": "turbo lint --filter=@repo/backend",
    "lint:mobile": "turbo lint --filter=@repo/mobile",
    "typecheck": "turbo typecheck",
    "typecheck:admin": "turbo typecheck --filter=@repo/admin",
    "typecheck:backend": "turbo typecheck --filter=@repo/backend",
    "typecheck:klx": "turbo typecheck --filter=@repo/klx-luxe-plus",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f mongodb",
    "app:run": "cd apps/mobile && flutter run",
    "app:doctor": "cd apps/mobile && flutter doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
