# ==============================================================================
# PoolPay Monorepo Production Environment Template
# Paste the content of this file (with your secrets filled) into GitHub Secrets as ENV_VER
# ==============================================================================

# ==============================================================================
# Server Connection Information (Read automatically by CI/CD from ENV_VER)
# ==============================================================================
EC2_HOST=16.171.186.103
EC2_USER=ubuntu
# Paste your full multiline private key within quotes:
EC2_SSH_KEY="-----BEGIN RSA PRIVATE KEY-----
your_rsa_private_key_content_here
-----END RSA PRIVATE KEY-----"

# Server & Networking
PORT=5000
IP=0.0.0.0
NODE_ENV=production

# Domains & URLs
FRONTEND_URL=https://poolpay.space
BACKEND_URL=https://api.poolpay.space
NEXT_PUBLIC_BASE_URL=https://api.poolpay.space
NEXT_PUBLIC_API_URL=https://api.poolpay.space/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
SELF_PING_ENABLED=true
RATE_LIMITER_ENABLED=false

# MongoDB Database (Production Docker: use @mongodb:27017)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=YourStrongDatabasePassword2026!
MONGO_INITDB_DATABASE=poolPay-db
DATABASE_URL=mongodb://admin:YourStrongDatabasePassword2026!@mongodb:27017/poolPay-db?authSource=admin
TEST_DATABASE_URL=mongodb://admin:YourStrongDatabasePassword2026!@mongodb:27017/poolPay-db?authSource=admin
LIVE_DATABASE_URL=mongodb://admin:YourStrongDatabasePassword2026!@mongodb:27017/poolPay-db?authSource=admin

# Redis (Production Docker: use redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
DISABLE_REDIS_WORKERS_IN_DEV=false

# Authentication & Security
AUTH_SYSTEM=custom
JWT_ACCESS_SECRET=your_32_or_64_char_hex_access_secret
JWT_REFRESH_SECRET=your_32_or_64_char_hex_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TIMEOUT_MINUTES=20
RESET_PASS_EXPIRES=10m
OTP_EXPIRES=2m
BCRYPT_SALT_ROUND=10
EXPRESS_SESSION_SECRET=your_express_session_secret
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Super Admin Account (Seeded on first launch)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@poolpay.space
SUPER_ADMIN_PASSWORD=PoolPayAdmin2026!

# Social OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.poolpay.space/api/v1/auth/google/callback

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=https://api.poolpay.space/api/v1/auth/facebook/callback

# Mobile In-App Purchases (Google Play & Apple StoreKit)
GOOGLE_PLAY_PACKAGE_NAME=com.poolpay.rosca
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=your_base64_encoded_google_play_service_account_json
GOOGLE_PLAY_REGULAR_PRODUCT_ID=regular_yearly_subscription
GOOGLE_PLAY_VIP_PRODUCT_ID=vip_yearly_subscription

APPLE_ISSUER_ID=your_apple_issuer_uuid
APPLE_KEY_ID=your_apple_key_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_BUNDLE_ID=com.poolpay.app
APPLE_PRIVATE_KEY_BASE64=your_base64_encoded_apple_p8_key
APPLE_REGULAR_PRODUCT_ID=regular_yearly_subscription
APPLE_VIP_PRODUCT_ID=vip_yearly_subscription

# AWS S3 Storage
STORAGE_PROVIDER=aws
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=poolpay

# Email Delivery (Resend)
EMAIL_PROVIDER=resend
SMTP_FORM=no-reply@poolpay.space
RESEND_API_KEY=re_your_resend_api_key

# Stripe Payments (Live Keys)
STRIPE_LIVE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_LIVE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=whsec_your_stripe_connect_webhook_secret

# Stripe Test Keys (Optional Fallback)
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_TEST_WEBHOOK_SECRET=whsec_your_test_webhook_secret
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=whsec_your_test_connect_webhook_secret

# Twilio SMS
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MG_your_messaging_service_sid

# Firebase Push Notifications
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_firebase_admin_service_account_json
