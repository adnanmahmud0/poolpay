# KLX LUXE PLUS LLC — Environment Variables Template
# Copy this file to .env.local for local overrides.
# When running locally, root .env is also loaded automatically if present.

PORT=5002
NODE_ENV=development

# Site & Business Configuration
KLX_SITE_URL=https://klxluxeplus.poolpay.space
KLX_SUPPORT_EMAIL=support@poolpay.space
KLX_OWNER_EMAIL=support@poolpay.space
KLX_PHONE="+1 (607) 900-4569"
KLX_TIMEZONE=America/New_York
KLX_CURRENCY=usd

# Database (falls back to DATABASE_URL if KLX_DATABASE_URL is not set)
KLX_DATABASE_URL=mongodb://admin:password@127.0.0.1:27017/klx_luxe_plus?authSource=admin
KLX_DB_NAME=klx_luxe_plus

# Admin Authentication & Sessions
KLX_SESSION_SECRET=change_this_to_a_secure_random_string_at_least_32_characters_long

# Stripe Payments
KLX_STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=sk_test_placeholder
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_placeholder
KLX_STRIPE_TEST_WEBHOOK_SECRET=whsec_placeholder

STRIPE_LIVE_SECRET_KEY=sk_live_placeholder
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_placeholder
KLX_STRIPE_LIVE_WEBHOOK_SECRET=whsec_placeholder

# Email Notifications (Resend / SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@poolpay.space
