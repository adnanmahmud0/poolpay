################################################################################
# POOLPAY Backend Environment Configuration
# 
# 🔒 STRICT ENVIRONMENT VALIDATION:
# The server implements a strict validator on startup. If any of the following
# critical required variables are missing, empty, or use default placeholders:
#   - DATABASE_URL
#   - JWT_ACCESS_SECRET
#   - JWT_REFRESH_SECRET
#   - SUPER_ADMIN_EMAIL
#   - SUPER_ADMIN_PASSWORD
# 
# The server will log a high-visibility warning to the console and exit immediately.
# Ensure you configure these properly before running the server locally.
################################################################################

# Port and IP address to run the server on
PORT=5000
IP=0.0.0.0

# Environment (development | production)
NODE_ENV=development

# MongoDB Connection URL
DATABASE_URL=mongodb://localhost:27017/poolPay-db

# Authentication System (passport | custom)
AUTH_SYSTEM=custom

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
RESET_PASS_EXPIRES=1h
OTP_EXPIRES=5m

# Password Hashing
BCRYPT_SALT_ROUND=10

# Frontend and Backend URLs for CORS and Redirects
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Express Session Secret (required if AUTH_SYSTEM=passport)
EXPRESS_SESSION_SECRET=your_session_secret_here

# Storage Configuration
# STORAGE_PROVIDER can be 'cloudinary', 'aws', 'digitalOcean', or 'local'
STORAGE_PROVIDER=local

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Credentials (Required if STORAGE_PROVIDER=aws)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=your_aws_region
AWS_BUCKET_NAME=your_bucket_name

# DigitalOcean Spaces Credentials (Required if STORAGE_PROVIDER=digitalOcean)
SPACES_ACCESS_KEY_ID=your_spaces_access_key_id
SPACES_SECRET_ACCESS_KEY=your_spaces_secret_access_key
SPACES_ENDPOINT=your_spaces_endpoint_url_without_bucket
SPACES_BUCKET_NAME=your_spaces_bucket_name
SPACES_REGION=your_spaces_region

# Social Authentication (Required if AUTH_SYSTEM=passport)
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Facebook Login
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# Super Admin Initial Credentials (for seeding)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@derival81.com
SUPER_ADMIN_PASSWORD=AdminPassword123!

# Email Configuration
# EMAIL_PROVIDER can be 'smtp', 'resend', or 'ses'
EMAIL_PROVIDER=smtp

# Common Sender Email (Used by all providers)
SMTP_FORM=no-reply@poolpay.space

# 1. SMTP Provider Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# 2. Resend Provider Config
RESEND_API_KEY=re_xxxxxxxxxxx

# 3. AWS SES Provider Config
# Note: SES also uses AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION 
# which should be defined in the "Storage Configuration" section above.

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Set to true to disable BullMQ workers and Native Scheduler in local development to save Redis commands/quota
DISABLE_REDIS_WORKERS_IN_DEV=false

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_REGULAR_PRICE_ID=price_...
STRIPE_VIP_PRICE_ID=price_...

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_ENABLED=false

#Encryption Key for sensitive data
ENCRYPTION_KEY=

# Firebase Configuration
# Base64 encoded string of the Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_firebase_credentials_here

# Rate Limiter Toggle
RATE_LIMITER_ENABLED=true

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/.....
SENTRY_DSN=

# Self-Ping Configuration (used to prevent Render spin-down/sleep)
SELF_PING_ENABLED=true
SELF_PING_INTERVAL=10

