{
  "name": "@repo/api",
  "version": "1.0.0",
  "description": "Derival81 / PoolPay Express.js, Mongoose & Socket.IO backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "tsup ./src/server.ts --format cjs --minify --clean",
    "start": "node ./dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "migrate:names": "tsx src/app/utils/migrations/splitNames.ts",
    "migrate:hashes": "tsx src/app/utils/migrations/cryptographicHashes.ts",
    "seed": "tsx ./src/app/utils/seedSuperAdmin.ts",
    "test": "jest"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "mongodb",
    "derival81",
    "poolpay"
  ],
  "author": "",
  "license": "MIT",
