# Retry persisted KLX email notifications once per minute.
* * * * * root docker exec poolpay_klx_prod node -e 'fetch("http://127.0.0.1:5002/api/jobs",{method:"POST",headers:{authorization:"Bearer "+process.env.KLX_JOB_SECRET}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))' >/dev/null 2>&1
